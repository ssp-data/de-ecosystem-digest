  "sql_queries": [
    [
      "main",
      "xorq_datafusion",
      "SELECT\n  *\nFROM (\n  SELECT\n    \"t1\".\"week\",\n    COUNT(\"t1\".\"id\") AS \"stars\"\n  FROM (\n    SELECT\n      \"t1\".\"id\",\n      \"t1\".\"created_at\",\n      \"t1\".\"type\",\n      \"t1\".\"repo_name\",\n      \"t1\".\"actor_login\",\n      \"t1\".\"week\"\n    FROM (\n      SELECT\n        \"t0\".\"id\",\n        \"t0\".\"created_at\",\n        \"t0\".\"type\",\n        \"t0\".\"repo_name\",\n        \"t0\".\"actor_login\",\n        DATE_TRUNC('WEEK', \"t0\".\"created_at\") AS \"week\"\n      FROM \"raw_github_events\" AS \"t0\"\n      WHERE\n        \"t0\".\"repo_name\" = 'dbt-labs/dbt-core'\n        AND \"t0\".\"type\" = 'WatchEvent'\n        AND \"t0\".\"created_at\" > ARROW_CAST('2026-07-13 18:17:16.168743', 'Timestamp(Microsecond, None)')\n    ) AS \"t1\"\n  ) AS t1\n  GROUP BY\n    \"t1\".\"week\"\n) AS \"t2\"\nORDER BY\n  \"t2\".\"week\" ASC"
    ]
  ],
