  "sql_queries": [
    [
      "main",
      "duckdb",
      "SELECT\n  *\nFROM (\n  SELECT\n    \"t1\".\"week\",\n    COUNT(\"t1\".\"id\") AS \"stars\"\n  FROM (\n    SELECT\n      \"t0\".\"id\",\n      \"t0\".\"created_at\",\n      \"t0\".\"type\",\n      \"t0\".\"repo_name\",\n      \"t0\".\"actor_login\",\n      DATE_TRUNC('WEEK', \"t0\".\"created_at\") AS \"week\"\n    FROM \"raw_github_events\" AS \"t0\"\n    WHERE\n      \"t0\".\"repo_name\" = 'dbt-labs/dbt-core'\n      AND \"t0\".\"type\" = 'WatchEvent'\n      AND \"t0\".\"created_at\" > MAKE_TIMESTAMP(2026, 7, 13, 18, 20, 49.378017)\n  ) AS \"t1\"\n  GROUP BY\n    1\n) AS \"t2\"\nORDER BY\n  \"t2\".\"week\" ASC"
    ]
  ],
